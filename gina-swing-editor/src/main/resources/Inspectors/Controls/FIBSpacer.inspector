<?xml version="1.0" encoding="UTF-8"?>
<Inspector layout="twocols" darkLevel="0" font="SansSerif,0,11"
	dataClassName="org.openflexo.gina.model.widget.FIBSpacer" name="Inspector">
	<CheckBox name="DynamicModelCB" index="20" selected="false"
		data="data.manageDynamicModel" constraints="twocols(location=left)"
		localize="true" visible="false" />
	<Label name="DynamicModelLabel" index="21" label="dynamic_model"
		constraints="twocols(expandHorizontally=true;location=right)"
		localize="true" visible="false" />
	<Label label="click_action" index="22" constraints="twocols(location=left)"
		localize="true" name="ClickActionLabel" visible="false" />
	<Custom index="23" componentClassName="org.openflexo.gina.swing.utils.JavaBindingSelector"
		localize="true" manageDynamicModel="true" data="data.clickAction" name="ClickBinding"
		constraints="twocols(expandHorizontally=true;location=right)" visible="false">
		<Assignment variable="component.bindable" value="data.eventListener" />
	</Custom>
	<Label index="24" label="double_click_action" constraints="twocols(location=left)"
		localize="true" name="DoubleClickActionLabel" visible="false"/>
	<Custom index="25" componentClassName="org.openflexo.gina.swing.utils.JavaBindingSelector"
		localize="true" manageDynamicModel="true" data="data.doubleClickAction" name="DoubleClickBinding"
		constraints="twocols(expandHorizontally=true;location=right)" visible="false">
		<Assignment variable="component.bindable" value="data.eventListener" />
	</Custom>
	<Label index="26" label="right_click_action" constraints="twocols(location=left)"
		localize="true" name="RightClickActionLabel" visible="false"/>
	<Custom index="27" componentClassName="org.openflexo.gina.swing.utils.JavaBindingSelector"
		localize="true" manageDynamicModel="true" data="data.rightClickAction" name="RightClickBinding"
		constraints="twocols(expandHorizontally=true;location=right)" visible="false">
		<Assignment variable="component.bindable" value="data.eventListener" />
	</Custom>
	<Label index="28" label="enter_pressed_action" constraints="twocols(location=left)"
		localize="true" name="EnterPressedActionLabel" visible="false"/>
	<Custom index="29" componentClassName="org.openflexo.gina.swing.utils.JavaBindingSelector"
		localize="true" manageDynamicModel="true" data="data.enterPressedAction" name="EnterPressedActionBinding"
		constraints="twocols(expandHorizontally=true;location=right)" visible="false">
		<Assignment variable="component.bindable" value="data" />
	</Custom>
	<Label index="30" label="value_changed" constraints="twocols(location=left)"
		localize="true" name="ValueChangedLabel" visible="false"/>
	<Custom index="31" componentClassName="org.openflexo.gina.swing.utils.JavaBindingSelector"
		localize="true" manageDynamicModel="true" data="data.valueChangedAction" name="ValueChangedBinding"
		constraints="twocols(expandHorizontally=true;location=right)" visible="false">
		<Assignment variable="component.bindable" value="data" />
	</Custom>
	<LocalizedDictionary>
	</LocalizedDictionary>
	<Parameter name="title" value="Spacer" />
</Inspector>
